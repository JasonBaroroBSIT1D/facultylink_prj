# Copy to .env and set values locally (.env is gitignored).
FLASK_ENV=development
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=change-me-in-development
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=3600
AUTH_COOKIE_NAME=facultylink_access
AUTH_COOKIE_SECURE=0
AUTH_COOKIE_SAMESITE=Lax

CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765,http://localhost:5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=facultylink_db
DB_USER=postgres
DB_PASSWORD=

# Optional override:
# DATABASE_URL=postgresql://postgres:@localhost:5432/facultylink_db

# Required for pytest — isolated database only (never facultylink_db):
# TEST_DATABASE_URL=postgresql+psycopg://postgres:@localhost:5432/facultylink_test_db
# Create/bootstrap: python backend/scripts/ensure_test_database.py

# Gmail / SMTP (invitations and password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
WEB_PORTAL_BASE_URL=http://127.0.0.1:8765
# Public HTTPS URL for reviewer/admin setup links in email (required for off-machine access)
# WEB_PORTAL_BASE_URL=https://facultylink.example.edu

# Faculty mobile: deep link opened by the Android app (default works on device with app installed)
MOBILE_APP_DEEP_LINK_BASE=facultylink://setup
# Optional HTTPS app link for verified Android App Links
# MOBILE_SETUP_HTTPS_URL=https://facultylink.example.edu/mobile/setup

PASSWORD_TOKEN_TTL_HOURS=72
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
TEMP_PASSWORD_TTL_HOURS=72
# Optional: authorized inbox for python backend/scripts/smtp_live_test.py
# SMTP_TEST_RECIPIENT=you@example.com
