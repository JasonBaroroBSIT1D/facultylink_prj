# Copy to .env and set values locally (.env is gitignored).
FLASK_ENV=development
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
SECRET_KEY=change-me-in-development
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=3600
AUTH_COOKIE_NAME=facultylink_access
AUTH_COOKIE_SECURE=0
AUTH_COOKIE_SAMESITE=Lax

CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765,http://localhost:5000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=facultylink_db
DB_USER=postgres
DB_PASSWORD=

# Optional override:
# DATABASE_URL=postgresql://postgres:@localhost:5432/facultylink_db
